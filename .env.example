# ============================================================
#  Server settings for Yo | The Business of You
#  Copy to your host's environment variables (Render: Environment tab).
#  Never commit real values.
# ============================================================

# Public address of the site (used in emails and Agent Yo links)
SITE_URL=https://www.yourdomain.com

# Admin dashboard access (long random string). Required in production.
ADMIN_TOKEN=

# Agent Yo — Claude API key from https://platform.claude.com (server-side only)
ANTHROPIC_API_KEY=
# Optional: voice ("warm and wise", "bold and funny", "polished and direct"), model and effort
AGENT_VOICE=warm and wise
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium

# Email: send confirmations and alerts through resend.com (otherwise they wait in the outbox)
RESEND_API_KEY=
MAIL_FROM=Yo <hello@yourdomain.com>
# Where hot-lead and discovery-call alerts go (Yo's inbox; an email-to-SMS address also works)
ALERT_EMAIL=

# CRM: every lead is POSTed here as JSON (Zapier, Make, HubSpot, Airtable…)
CRM_WEBHOOK_URL=

# Database file location (point at a persistent disk in production)
# DB_PATH=/var/data/site.db
NODE_ENV=production
